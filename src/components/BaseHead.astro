---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/blog-placeholder-1.jpg";
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  keywords?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, keywords } = Astro.props;

// Resolve the share/social image: accepts an imported asset or a URL string
const ogImageUrl =
  typeof image === "string"
    ? new URL(image, Astro.url).href
    : new URL(image.src, Astro.url).href;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Google Consent Mode v2 Initialization -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  // Set default consent to 'denied'
  if (!localStorage.getItem("cookie-consent")) {
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      wait_for_update: 500,
    });
    // Advanced Consent Mode features
    gtag("set", "ads_data_redaction", true);
    gtag("set", "url_passthrough", true);
  } else {
    const consent = JSON.parse(localStorage.getItem("cookie-consent"));
    gtag("consent", "default", consent);
  }
</script>

<!-- Google Tag Manager -->
<script is:inline>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != "dataLayer" ? "&l=" + l : "";
    j.async = true;
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, "script", "dataLayer", "GTM-5447QWGH");
</script>
<!-- End Google Tag Manager -->

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta
  name="keywords"
  content={keywords || "Graphic Design, Web Design, AI Content, Cairo, Egypt"}
/>

<!-- Bilingual SEO -->
<!-- Removed hreflang tags to fix Search Console URL mapping errors since translations are handled client-side on the same URL -->

<!-- SEO Meta Tags -->
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#f59e0b" />

<!-- Google Search Console Verification -->
<meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" />

<!-- Font preloads -->
<link
  rel="preload"
  href="/fonts/atkinson-regular.woff"
  as="font"
  type="font/woff"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/atkinson-bold.woff"
  as="font"
  type="font/woff"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Omar Abdelfattah" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Structured Data (JSON-LD) -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://omarcreatives.com/#website",
        url: "https://omarcreatives.com",
        name: SITE_TITLE,
        description: description,
        publisher: {
          "@id": "https://omarcreatives.com/#organization",
        },
      },
      {
        "@type": "Organization",
        "@id": "https://omarcreatives.com/#organization",
        name: "Omar Creatives",
        url: "https://omarcreatives.com",
        logo: {
          "@type": "ImageObject",
          url: "https://omarcreatives.com/favicon.png",
        },
        contactPoint: {
          "@type": "ContactPoint",
          telephone: "+20-121-186-7464",
          contactType: "customer service",
        },
      },
    ],
  })}
/>

<!-- Google Analytics (GA4) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JPQYT5XQP4"
></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "G-JPQYT5XQP4");
</script>

<!-- Cloudflare Web Analytics -->
<script
  is:inline
  defer
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon='{"token": "YOUR_CF_ANALYTICS_TOKEN"}'></script>

<!-- Language/RTL Support + body class for project language switching -->
<script is:inline>
  (function () {
    // Default to Arabic on mobile devices, English on desktop
    const defaultLang = window.matchMedia("(max-width: 900px)").matches
      ? "ar"
      : "en";
    const savedLang = localStorage.getItem("language") || defaultLang;
    document.documentElement.dir = savedLang === "ar" ? "rtl" : "ltr";
    document.documentElement.lang = savedLang;
    function setBodyLang() {
      if (document.body) {
        document.body.classList.remove("is-en", "is-ar");
        document.body.classList.add(savedLang === "ar" ? "is-ar" : "is-en");
      }
    }
    setBodyLang();
    if (!document.body)
      document.addEventListener("DOMContentLoaded", setBodyLang);
  })();
</script>

<!-- Google Fonts for Arabic -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700&display=swap"
  rel="stylesheet"
/>

<!-- i18n Translation Script -->
<script is:inline src="/js/i18n.js"></script>
