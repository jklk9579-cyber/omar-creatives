---
/**
 * CookieConsent.astro
 * A premium glassmorphic cookie consent banner
 */
import { getTranslation } from "../i18n/translations";

const lang = Astro.url.pathname.startsWith("/ar") ? "ar" : "en";

const t = {
    title: getTranslation(lang, "cookie", "title"),
    description: getTranslation(lang, "cookie", "description"),
    accept: getTranslation(lang, "cookie", "accept"),
    decline: getTranslation(lang, "cookie", "decline"),
};
---

<div id="cookie-banner" class="cookie-banner hidden">
    <div class="cookie-content">
        <div class="cookie-header">
            <span class="cookie-icon">🍪</span>
            <h3>{t.title}</h3>
        </div>
        <p>{t.description}</p>
        <div class="cookie-actions">
            <button id="decline-cookies" class="btn-secondary"
                >{t.decline}</button
            >
            <button id="accept-cookies" class="btn-primary">{t.accept}</button>
        </div>
    </div>
</div>

<style>
    .cookie-banner {
        position: fixed;
        bottom: 2rem;
        left: 2rem;
        right: 2rem;
        max-width: 500px;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.5rem;
        padding: 1.5rem;
        z-index: 9999;
        box-shadow:
            0 20px 25px -5px rgba(0, 0, 0, 0.3),
            0 10px 10px -5px rgba(0, 0, 0, 0.2);
        transform: translateY(0);
        transition:
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.4s ease;
    }

    .cookie-banner.hidden {
        transform: translateY(120%);
        opacity: 0;
        pointer-events: none;
    }

    /* Responsive for mobile */
    @media (max-width: 640px) {
        .cookie-banner {
            bottom: 1rem;
            left: 1rem;
            right: 1rem;
            max-width: none;
        }
    }

    .cookie-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .cookie-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .cookie-icon {
        font-size: 1.5rem;
    }

    .cookie-header h3 {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 700;
        color: #fff;
    }

    .cookie-content p {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.7);
    }

    .cookie-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .btn-primary,
    .btn-secondary {
        flex: 1;
        padding: 0.625rem 1rem;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
        text-align: center;
    }

    .btn-primary {
        background: #f59e0b;
        color: #000;
    }

    .btn-primary:hover {
        background: #d97706;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    /* RTL Support */
    :global([dir="rtl"]) .cookie-banner {
        left: auto;
        right: 2rem;
    }

    @media (max-width: 640px) {
        :global([dir="rtl"]) .cookie-banner {
            right: 1rem;
        }
    }
</style>

<script is:inline>
    (function () {
        const banner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("accept-cookies");
        const declineBtn = document.getElementById("decline-cookies");

        // Show banner if no consent choice has been made
        if (!localStorage.getItem("cookie-consent")) {
            setTimeout(() => {
                banner.classList.remove("hidden");
            }, 1000);
        }

        function updateConsent(choice) {
            const consent = {
                ad_storage: choice,
                ad_user_data: choice,
                ad_personalization: choice,
                analytics_storage: choice,
            };

            // Save to localStorage
            localStorage.setItem("cookie-consent", JSON.stringify(consent));

            // Update GTM/GA4
            if (typeof gtag === "function") {
                gtag("consent", "update", consent);
            }

            // Hide banner
            banner.classList.add("hidden");
        }

        acceptBtn.addEventListener("click", () => updateConsent("granted"));
        declineBtn.addEventListener("click", () => updateConsent("denied"));
    })();
</script>
