---
// TechnicalArsenal.astro — Component showcasing Omar's Creative & Technical Arsenal
---

<section class="technical-arsenal-section" id="technical-arsenal">
	<div class="arsenal-container">
		<!-- Section Header -->
		<div class="arsenal-header">
			<div class="arsenal-badge">
				<span class="badge-icon">✦</span>
				<span class="lang-en">CREATIVE & TECHNICAL ARSENAL</span>
				<span class="lang-ar">الترسانة الإبداعية والتقنية</span>
			</div>
			<h2 class="arsenal-title">
				<span class="lang-en">Design, Video & Production Stack</span>
				<span class="lang-ar">أدوات التصميم، المونتاج، والبرمجة الحديثة</span>
			</h2>
			<p class="arsenal-subtitle">
				<span class="lang-en">A unified creative workflow combining industry-standard graphic design, cinematic video production, generative AI media pipelines, and full-stack web engineering.</span>
				<span class="lang-ar">منظومة عمل متكاملة تجمع بين أرقى برامج التصميم وصناعة الفيديو والموشن جرافيك، مسارات الذكاء الاصطناعي التوليدي، وهندسة منصات الويب الحديثة.</span>
			</p>
			<div class="arsenal-header-line"></div>
		</div>

		<!-- Arsenal Grid -->
		<div class="arsenal-grid">
			<!-- Category 1: Graphic Design & Brand Identity -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap design">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 19l7-7 3 3-7 7-3-3z"></path>
							<path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
							<path d="M2 2l7.586 7.586"></path>
							<circle cx="11" cy="11" r="2"></circle>
						</svg>
					</div>
					<div class="cat-title-wrap">
						<h3 class="cat-title">
							<span class="lang-en">Graphic Design & Branding</span>
							<span class="lang-ar">تصميم الجرافيك والهوية البصرية</span>
						</h3>
						<span class="cat-subtitle">
							<span class="lang-en">Visual Identity & Creative Direction</span>
							<span class="lang-ar">الهويات التجارية والتوجيه الإبداعي</span>
						</span>
					</div>
				</div>
				<div class="pills-container">
					<span class="pill pill-featured">Adobe Photoshop</span>
					<span class="pill pill-featured">Adobe Illustrator</span>
					<span class="pill pill-featured">Adobe InDesign</span>
					<span class="pill">Figma</span>
					<span class="pill">Canva Pro</span>
					<span class="pill">Brand Identity & Guidelines</span>
					<span class="pill">Typography & Layout</span>
					<span class="pill">Social Media Creatives</span>
					<span class="pill">Print & Packaging</span>
					<span class="pill">Vector Illustration</span>
				</div>
			</div>

			<!-- Category 2: Video Production & Motion Graphics -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap video">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="23 7 16 12 23 17 23 7"></polygon>
							<rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
						</svg>
					</div>
					<div class="cat-title-wrap">
						<h3 class="cat-title">
							<span class="lang-en">Video Production & Motion</span>
							<span class="lang-ar">صناعة الفيديو والموشن جرافيك</span>
						</h3>
						<span class="cat-subtitle">
							<span class="lang-en">Cinematic Editing & Visual Effects</span>
							<span class="lang-ar">المونتاج السينمائي والمؤثرات البصرية</span>
						</span>
					</div>
				</div>
				<div class="pills-container">
					<span class="pill pill-featured">Adobe Premiere Pro</span>
					<span class="pill pill-featured">Adobe After Effects</span>
					<span class="pill pill-featured">DaVinci Resolve Studio</span>
					<span class="pill">CapCut Pro</span>
					<span class="pill">Motion Graphics</span>
					<span class="pill">Cinematic Color Grading (LUTs)</span>
					<span class="pill">Sound Design & Audio Mixing</span>
					<span class="pill">4K Video Editing</span>
					<span class="pill">Reels & TikTok Production</span>
					<span class="pill">Visual Effects (VFX)</span>
				</div>
			</div>

			<!-- Category 3: UI/UX & Digital Product Design -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap uiux">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
							<line x1="8" y1="21" x2="16" y2="21"></line>
							<line x1="12" y1="17" x2="12" y2="21"></line>
						</svg>
					</div>
					<div class="cat-title-wrap">
						<h3 class="cat-title">
							<span class="lang-en">UI/UX & Product Design</span>
							<span class="lang-ar">تصميم واجهات وتجربة المستخدم</span>
						</h3>
						<span class="cat-subtitle">
							<span class="lang-en">Design Systems & Interactive Prototypes</span>
							<span class="lang-ar">نظم التصميم والنماذج التفاعلية</span>
						</span>
					</div>
				</div>
				<div class="pills-container">
					<span class="pill pill-featured">Figma Design Systems</span>
					<span class="pill pill-featured">Interactive Prototyping</span>
					<span class="pill">Wireframing & User Flows</span>
					<span class="pill">Mobile & Web UI</span>
					<span class="pill">Design Tokens & Variables</span>
					<span class="pill">Micro-interactions</span>
					<span class="pill">UX Research & Usability</span>
					<span class="pill">Bilingual RTL / LTR Architecture</span>
				</div>
			</div>

			<!-- Category 4: Generative AI & Creative Pipelines -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap ai">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
						</svg>
					</div>
					<div class="cat-title-wrap">
						<h3 class="cat-title">
							<span class="lang-en">Generative AI & Media Pipelines</span>
							<span class="lang-ar">الذكاء الاصطناعي التوليدي والميديا</span>
						</h3>
						<span class="cat-subtitle">
							<span class="lang-en">AI Visuals, Video Gen & Automation</span>
							<span class="lang-ar">توليد الصور والفيديو والأتمتة الذكية</span>
						</span>
					</div>
				</div>
				<div class="pills-container">
					<span class="pill pill-featured">Midjourney v6</span>
					<span class="pill pill-featured">Runway Gen-2 & Gen-3</span>
					<span class="pill pill-featured">Stable Diffusion & ComfyUI</span>
					<span class="pill">ElevenLabs Voice AI</span>
					<span class="pill">Kling AI & Luma Dream Machine</span>
					<span class="pill">Topaz Video AI</span>
					<span class="pill">DALL-E 3</span>
					<span class="pill">Ollama (Local LLMs)</span>
					<span class="pill">N8N Creative Automation</span>
				</div>
			</div>

			<!-- Category 5: Frontend Web Engineering -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap frontend">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="16 18 22 12 16 6"></polyline>
							<polyline points="8 6 2 12 8 18"></polyline>
						</svg>
					</div>
					<div class="cat-title-wrap">
						<h3 class="cat-title">
							<span class="lang-en">Frontend Web Engineering</span>
							<span class="lang-ar">هندسة الواجهات وتطوير الويب</span>
						</h3>
						<span class="cat-subtitle">
							<span class="lang-en">Modern Architecture & Sub-second Speed</span>
							<span class="lang-ar">معمارية الويب الحديثة والسرعة الفائقة</span>
						</span>
					</div>
				</div>
				<div class="pills-container">
					<span class="pill pill-featured">Next.js 16/15 (App Router)</span>
					<span class="pill pill-featured">React 19</span>
					<span class="pill pill-featured">Astro Framework</span>
					<span class="pill">TypeScript</span>
					<span class="pill">Tailwind CSS v4</span>
					<span class="pill">Turborepo</span>
					<span class="pill">Three.js & WebGL</span>
					<span class="pill">Framer Motion</span>
					<span class="pill">Core Web Vitals & SEO</span>
				</div>
			</div>

			<!-- Category 6: Backend, Cloud & Infrastructure -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap backend">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
							<rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
							<line x1="6" y1="6" x2="6.01" y2="6"></line>
							<line x1="6" y1="18" x2="6.01" y2="18"></line>
						</svg>
					</div>
					<div class="cat-title-wrap">
						<h3 class="cat-title">
							<span class="lang-en">Backend & Cloud Infrastructure</span>
							<span class="lang-ar">الأنظمة السحابية والبنية التحتية</span>
						</h3>
						<span class="cat-subtitle">
							<span class="lang-en">High-Reliability APIs & Edge Deployment</span>
							<span class="lang-ar">الواجهات البرمجية والنشر السحابي الموثوق</span>
						</span>
					</div>
				</div>
				<div class="pills-container">
					<span class="pill pill-featured">Node.js</span>
					<span class="pill pill-featured">NestJS & Express</span>
					<span class="pill pill-featured">PostgreSQL 16</span>
					<span class="pill">Prisma ORM</span>
					<span class="pill">Docker Multi-Stage</span>
					<span class="pill">Cloudflare Workers & Edge CDN</span>
					<span class="pill">REST & Webhooks (Stripe / Meta)</span>
					<span class="pill">GitHub Actions CI/CD</span>
				</div>
			</div>

			<!-- Category 7: Languages & Global Communication (Full Width Card) -->
			<div class="arsenal-card card-wide">
				<div class="cat-header">
					<div class="cat-icon-wrap languages">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="2" y1="12" x2="22" y2="12"></line>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
						</svg>
					</div>
					<div class="cat-title-wrap">
						<h3 class="cat-title">
							<span class="lang-en">Languages & Global Communication</span>
							<span class="lang-ar">اللغات والتواصل الدولي</span>
						</h3>
						<span class="cat-subtitle">
							<span class="lang-en">Native bilingual fluency with international clients</span>
							<span class="lang-ar">طلاقة لغوية كاملة وتواصل سلس مع العملاء محلياً وعالمياً</span>
						</span>
					</div>
				</div>
				<div class="pills-container">
					<span class="pill pill-featured">
						<span class="lang-en">Arabic (Native / Mother Tongue)</span>
						<span class="lang-ar">العربية (اللغة الأم)</span>
					</span>
					<span class="pill pill-featured">
						<span class="lang-en">English (Native Fluency)</span>
						<span class="lang-ar">الإنجليزية (طلاقة كاملة كاللغة الأم)</span>
					</span>
					<span class="pill">
						<span class="lang-en">Full RTL & LTR Content Strategy</span>
						<span class="lang-ar">استراتيجية المحتوى ثنائي اللغة (عربي / إنجليزي)</span>
					</span>
					<span class="pill">
						<span class="lang-en">Async Remote Collaboration</span>
						<span class="lang-ar">إدارة وتنسيق العمل عن بُعد بسلاسة</span>
					</span>
					<span class="pill">
						<span class="lang-en">Cross-Border Delivery</span>
						<span class="lang-ar">تسليم المشاريع للعملاء عالمياً</span>
					</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.technical-arsenal-section {
		padding: 5.5rem 2rem;
		position: relative;
		background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.05) 0%, transparent 60%),
		            radial-gradient(circle at 85% 85%, rgba(245, 158, 11, 0.03) 0%, transparent 50%),
		            #050505;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		overflow: hidden;
	}

	.arsenal-container {
		max-width: 1300px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	/* Section Header */
	.arsenal-header {
		margin-bottom: 3.5rem;
		position: relative;
	}

	.arsenal-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: "JetBrains Mono", "Courier New", monospace;
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: #f59e0b;
		text-transform: uppercase;
		margin-bottom: 1rem;
		background: rgba(245, 158, 11, 0.08);
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid rgba(245, 158, 11, 0.25);
	}

	.arsenal-badge .badge-icon {
		color: #f59e0b;
		font-size: 0.95rem;
	}

	.arsenal-title {
		font-size: clamp(2rem, 3.5vw, 2.75rem);
		font-weight: 800;
		color: #ffffff;
		line-height: 1.25;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}

	.arsenal-subtitle {
		font-size: 1.08rem;
		color: rgba(255, 255, 255, 0.68);
		max-width: 820px;
		line-height: 1.75;
		margin-bottom: 1.5rem;
	}

	.arsenal-header-line {
		width: 100%;
		height: 1px;
		background: linear-gradient(90deg, rgba(245, 158, 11, 0.5) 0%, rgba(255, 255, 255, 0.1) 40%, transparent 100%);
	}

	/* Arsenal Cards Grid */
	.arsenal-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	.arsenal-card {
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 20px;
		padding: 2.2rem 2rem;
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.35s ease, box-shadow 0.35s ease;
	}

	.arsenal-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(245, 158, 11, 0.35), transparent);
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.arsenal-card:hover {
		transform: translateY(-5px);
		border-color: rgba(245, 158, 11, 0.35);
		box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), 0 0 25px rgba(245, 158, 11, 0.08);
	}

	.arsenal-card:hover::before {
		opacity: 1;
	}

	.arsenal-card.card-wide {
		grid-column: 1 / -1;
		background: linear-gradient(145deg, rgba(245, 158, 11, 0.04) 0%, rgba(255, 255, 255, 0.015) 100%);
		border-color: rgba(245, 158, 11, 0.2);
	}

	/* Card Header & Icon */
	.cat-header {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin-bottom: 1.6rem;
	}

	.cat-icon-wrap {
		width: 46px;
		height: 46px;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: transform 0.3s ease;
	}

	.arsenal-card:hover .cat-icon-wrap {
		transform: scale(1.08);
	}

	/* Refined Harmonious Category Colors */
	.cat-icon-wrap.design {
		color: #fb7185;
		background: rgba(251, 113, 133, 0.12);
		border: 1px solid rgba(251, 113, 133, 0.28);
	}

	.cat-icon-wrap.video {
		color: #c084fc;
		background: rgba(192, 132, 252, 0.12);
		border: 1px solid rgba(192, 132, 252, 0.28);
	}

	.cat-icon-wrap.uiux {
		color: #818cf8;
		background: rgba(129, 140, 248, 0.12);
		border: 1px solid rgba(129, 140, 248, 0.28);
	}

	.cat-icon-wrap.ai {
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.12);
		border: 1px solid rgba(245, 158, 11, 0.28);
	}

	.cat-icon-wrap.frontend {
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.12);
		border: 1px solid rgba(56, 189, 248, 0.28);
	}

	.cat-icon-wrap.backend {
		color: #34d399;
		background: rgba(52, 211, 153, 0.12);
		border: 1px solid rgba(52, 211, 153, 0.28);
	}

	.cat-icon-wrap.languages {
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.12);
		border: 1px solid rgba(245, 158, 11, 0.28);
	}

	.cat-title-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.cat-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.cat-subtitle {
		font-size: 0.82rem;
		color: rgba(255, 255, 255, 0.5);
		font-weight: 400;
	}

	/* Pills Container */
	.pills-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.95rem;
		font-size: 0.88rem;
		font-weight: 500;
		border-radius: 9px;
		background: rgba(255, 255, 255, 0.035);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.88);
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		user-select: none;
	}

	.pill:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(245, 158, 11, 0.4);
		color: #ffffff;
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
	}

	/* Featured primary skills in luxury Amber / Gold */
	.pill.pill-featured {
		background: rgba(245, 158, 11, 0.08);
		border: 1px solid rgba(245, 158, 11, 0.45);
		color: #fbbf24;
		font-weight: 600;
		box-shadow: 0 0 12px rgba(245, 158, 11, 0.08);
	}

	.pill.pill-featured:hover {
		background: rgba(245, 158, 11, 0.18);
		border-color: #f59e0b;
		color: #ffffff;
		box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
		transform: translateY(-2px);
	}

	/* RTL & Arabic Support */
	:global([dir="rtl"]) .arsenal-header {
		text-align: right;
	}

	:global([dir="rtl"]) .arsenal-header-line {
		background: linear-gradient(270deg, rgba(245, 158, 11, 0.5) 0%, rgba(255, 255, 255, 0.1) 40%, transparent 100%);
	}

	:global([dir="rtl"]) .cat-header {
		flex-direction: row;
	}

	:global([dir="rtl"]) .arsenal-title {
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
	}

	:global([dir="rtl"]) .arsenal-subtitle {
		font-family: "Tafkir", "Cairo", "Tajawal", sans-serif;
	}

	:global([dir="rtl"]) .cat-title {
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
	}

	:global([dir="rtl"]) .cat-subtitle {
		font-family: "Tafkir", "Cairo", "Tajawal", sans-serif;
	}

	:global([dir="rtl"]) .pill {
		font-family: "Inter", "Tafkir", sans-serif;
	}

	/* Critical: prevent lang-ar block override from breaking inline pills & badges */
	:global(body.is-ar) .arsenal-badge .lang-ar,
	:global(body.is-ar) .pill .lang-ar {
		display: inline-block !important;
	}

