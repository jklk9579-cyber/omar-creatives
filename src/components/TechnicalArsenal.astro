---
// TechnicalArsenal.astro — Component showcasing Omar's technical stack
---

<section class="technical-arsenal-section" id="technical-arsenal">
	<div class="arsenal-container">
		<!-- Section Header -->
		<div class="arsenal-header">
			<div class="arsenal-badge">
				<span class="code-bracket">&lt;&gt;</span>
				<span class="lang-en">TECHNICAL ARSENAL</span>
				<span class="lang-ar">الترسانة التقنية والبرمجية</span>
			</div>
			<h2 class="arsenal-title">
				<span class="lang-en">Production Engineering & AI Capabilities</span>
				<span class="lang-ar">البنية الهندسية وتكاملات الذكاء الاصطناعي</span>
			</h2>
			<p class="arsenal-subtitle">
				<span class="lang-en">Modern front-end architecture, rock-solid backend infrastructure, and production-grade generative AI automation pipelines.</span>
				<span class="lang-ar">منظومة برمجية متكاملة تجمع بين هندسة الواجهات الحديثة، البنية التحتية السحابية الموثوقة، وتطبيقات الذكاء الاصطناعي المتقدمة.</span>
			</p>
			<div class="arsenal-header-line"></div>
		</div>

		<!-- Arsenal Grid -->
		<div class="arsenal-grid">
			<!-- Category 1: Frontend Engineering -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap frontend">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
							<line x1="8" y1="21" x2="16" y2="21"></line>
							<line x1="12" y1="17" x2="12" y2="21"></line>
						</svg>
					</div>
					<h3 class="cat-title">
						<span class="lang-en">Frontend Engineering</span>
						<span class="lang-ar">هندسة الواجهات الأمامية</span>
					</h3>
				</div>
				<div class="pills-container">
					<span class="pill pill-amber">Next.js 16/15 (App Router)</span>
					<span class="pill pill-amber">React 19</span>
					<span class="pill pill-amber">TypeScript</span>
					<span class="pill">Tailwind CSS v4</span>
					<span class="pill">Turborepo</span>
					<span class="pill pill-cyan">Bilingual RTL/LTR</span>
					<span class="pill">Three.js</span>
					<span class="pill">Framer Motion</span>
				</div>
			</div>

			<!-- Category 2: Backend & DevOps -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap backend">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
							<rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
							<line x1="6" y1="6" x2="6.01" y2="6"></line>
							<line x1="6" y1="18" x2="6.01" y2="18"></line>
						</svg>
					</div>
					<h3 class="cat-title">
						<span class="lang-en">Backend & DevOps</span>
						<span class="lang-ar">الأنظمة الخلفية والبنية التحتية</span>
					</h3>
				</div>
				<div class="pills-container">
					<span class="pill pill-amber">Node.js</span>
					<span class="pill pill-amber">NestJS & Express</span>
					<span class="pill pill-amber">PostgreSQL 16</span>
					<span class="pill">Prisma ORM</span>
					<span class="pill">Docker Multi-Stage</span>
					<span class="pill">Portainer & Linux VPS</span>
					<span class="pill">Nginx Reverse Proxy</span>
					<span class="pill">GitHub Actions CI/CD</span>
				</div>
			</div>

			<!-- Category 3: AI & Production Integrations -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap ai">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
						</svg>
					</div>
					<h3 class="cat-title">
						<span class="lang-en">AI & Production Integrations</span>
						<span class="lang-ar">أنظمة وتكاملات الذكاء الاصطناعي</span>
					</h3>
				</div>
				<div class="pills-container">
					<span class="pill pill-amber">Ollama (Local LLM Qwen)</span>
					<span class="pill pill-amber">Zhipu AI (GLM-4 Cloud)</span>
					<span class="pill">Meta WhatsApp Cloud v21</span>
					<span class="pill">Stripe Webhooks</span>
					<span class="pill">N8N Automation</span>
					<span class="pill">Generative AI Media</span>
				</div>
			</div>

			<!-- Category 4: Languages -->
			<div class="arsenal-card">
				<div class="cat-header">
					<div class="cat-icon-wrap languages">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="2" y1="12" x2="22" y2="12"></line>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
						</svg>
					</div>
					<h3 class="cat-title">
						<span class="lang-en">Languages</span>
						<span class="lang-ar">اللغات</span>
					</h3>
				</div>
				<div class="pills-container">
					<span class="pill pill-amber">
						<span class="lang-en">Arabic (Native)</span>
						<span class="lang-ar">العربية (اللغة الأم)</span>
					</span>
					<span class="pill pill-amber">
						<span class="lang-en">English (Native)</span>
						<span class="lang-ar">الإنجليزية (اللغة الأم)</span>
					</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.technical-arsenal-section {
		padding: 5rem 2rem;
		position: relative;
		background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.04) 0%, transparent 60%),
		            radial-gradient(circle at 80% 80%, rgba(14, 165, 233, 0.03) 0%, transparent 50%),
		            #06070a;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		overflow: hidden;
	}

	.arsenal-container {
		max-width: 1300px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	/* Section Header */
	.arsenal-header {
		margin-bottom: 3.5rem;
		position: relative;
	}

	.arsenal-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: "JetBrains Mono", "Courier New", monospace;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #f59e0b;
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.arsenal-badge .code-bracket {
		color: #f97316;
		font-weight: 800;
	}

	.arsenal-title {
		font-size: clamp(2rem, 3.5vw, 2.75rem);
		font-weight: 800;
		color: #ffffff;
		line-height: 1.25;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}

	.arsenal-subtitle {
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.65);
		max-width: 760px;
		line-height: 1.75;
		margin-bottom: 1.5rem;
	}

	.arsenal-header-line {
		width: 100%;
		height: 1px;
		background: linear-gradient(90deg, rgba(245, 158, 11, 0.5) 0%, rgba(255, 255, 255, 0.1) 40%, transparent 100%);
	}

	/* Arsenal Cards Grid */
	.arsenal-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	.arsenal-card {
		background: rgba(13, 16, 26, 0.7);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 20px;
		padding: 2.2rem 2rem;
		position: relative;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.arsenal-card:hover {
		transform: translateY(-4px);
		border-color: rgba(245, 158, 11, 0.3);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(245, 158, 11, 0.08);
	}

	.cat-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.6rem;
	}

	.cat-icon-wrap {
		width: 42px;
		height: 42px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: #ffffff;
		flex-shrink: 0;
	}

	.cat-icon-wrap.frontend {
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.1);
		border-color: rgba(56, 189, 248, 0.25);
	}

	.cat-icon-wrap.backend {
		color: #a855f7;
		background: rgba(168, 85, 247, 0.1);
		border-color: rgba(168, 85, 247, 0.25);
	}

	.cat-icon-wrap.ai {
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.1);
		border-color: rgba(245, 158, 11, 0.25);
	}

	.cat-icon-wrap.languages {
		color: #10b981;
		background: rgba(16, 185, 129, 0.1);
		border-color: rgba(16, 185, 129, 0.25);
	}

	.cat-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.01em;
	}

	/* Pills Container */
	.pills-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 1.05rem;
		font-size: 0.9rem;
		font-weight: 500;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.035);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.85);
		transition: all 0.25s ease;
		user-select: none;
	}

	.pill:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.25);
		color: #ffffff;
		transform: translateY(-2px);
	}

	/* Amber highlighted pills (as seen in screenshot) */
	.pill.pill-amber {
		background: rgba(245, 158, 11, 0.08);
		border: 1px solid rgba(245, 158, 11, 0.55);
		color: #fbbf24;
		box-shadow: 0 0 16px rgba(245, 158, 11, 0.1);
	}

	.pill.pill-amber:hover {
		background: rgba(245, 158, 11, 0.16);
		border-color: #f59e0b;
		color: #ffffff;
		box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
	}

	/* Cyan highlighted pill (Bilingual RTL/LTR) */
	.pill.pill-cyan {
		background: rgba(14, 165, 233, 0.1);
		border: 1px solid rgba(14, 165, 233, 0.6);
		color: #38bdf8;
		box-shadow: 0 0 14px rgba(14, 165, 233, 0.15);
	}

	.pill.pill-cyan:hover {
		background: rgba(14, 165, 233, 0.2);
		border-color: #38bdf8;
		color: #ffffff;
		box-shadow: 0 0 22px rgba(14, 165, 233, 0.3);
	}

	/* RTL Support */
	:global([dir="rtl"]) .arsenal-header {
		text-align: right;
	}

	:global([dir="rtl"]) .arsenal-header-line {
		background: linear-gradient(270deg, rgba(245, 158, 11, 0.5) 0%, rgba(255, 255, 255, 0.1) 40%, transparent 100%);
	}

	:global([dir="rtl"]) .cat-header {
		flex-direction: row;
	}

	:global([dir="rtl"]) .arsenal-title {
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
	}

	:global([dir="rtl"]) .arsenal-subtitle {
		font-family: "Tafkir", "Cairo", "Tajawal", sans-serif;
	}

	:global([dir="rtl"]) .cat-title {
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
	}

	:global([dir="rtl"]) .pill {
		font-family: "Inter", "Tafkir", sans-serif;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.arsenal-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.technical-arsenal-section {
			padding: 3.5rem 1.25rem;
		}

		.arsenal-card {
			padding: 1.75rem 1.5rem;
		}
	}
</style>
