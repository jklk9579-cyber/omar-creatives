		<a
			href="https://github.com/omarabdelfattah"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="GitHub"
		>
			<svg viewBox="0 0 24 24" width="18" height="18">
				<path
					fill="currentColor"
					d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
				></path>
			</svg>
		</a>
	</div>
</div>
<style>
	:root {
		--header-height: 169px;
	}
	@media (max-width: 900px) {
		:root {
			--header-height: 89px;
		}
	}
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		padding: 1.5rem 4rem;
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border: none;
		border-bottom: none;
		box-shadow: none;
		outline: none;
		transition: padding 0.35s ease, box-shadow 0.35s ease, background 0.35s ease, border-color 0.35s ease, backdrop-filter 0.35s ease;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 100%;
		margin: 0 auto;
	}
	.logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
	}
	.logo {
		height: 120px;
		width: auto;
		transition: height 0.35s ease;
		filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.6));
	}

	/* Compact header once the page is scrolled (frees vertical space) */
	header.scrolled {
		padding: 0.75rem 2rem;
		background: rgba(10, 10, 10, 0.92);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
	}
	header.scrolled .logo {
		height: 72px;
	}
	.internal-links {
		display: flex;
		gap: 1.25rem;
	}
	.internal-links :global(a) {
		padding: 0.85rem 1.5rem;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 1.35rem;
		border-radius: 8px;
		transition: all 0.3s ease;
		font-family: "Motivate", "Inter", sans-serif;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--text-primary);
		background: var(--bg-card);
	}
	.nav-cta {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.contact-btn {
		padding: 1rem 2rem;
		background: var(--accent-gradient);
		color: #000;
		text-decoration: none;
		border-radius: 12px;
		font-weight: 600;
		font-size: 1.3rem;
		transition: all 0.3s ease;
		font-family: "Motivate", "Inter", sans-serif;
	}
	.contact-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 5px 20px rgba(245, 158, 11, 0.3);
	}

	/* Mobile Menu Button */
	.mobile-menu-btn {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 6px;
		width: 44px;
		height: 44px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		cursor: pointer;
		padding: 0;
		z-index: 1001;
		transition: all 0.3s ease;
	}
	.mobile-menu-btn:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(245, 158, 11, 0.4);
	}
	.mobile-menu-btn span {
		width: 22px;
		height: 2px;
		background: var(--text-primary);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		border-radius: 2px;
	}
	.mobile-menu-btn.active span:nth-child(1) {
		transform: translateY(8px) rotate(45deg);
	}
	.mobile-menu-btn.active span:nth-child(2) {
		opacity: 0;
		transform: scale(0);
	}
	.mobile-menu-btn.active span:nth-child(3) {
		transform: translateY(-8px) rotate(-45deg);
	}

	/* ── Premium side drawer (mobile menu) ── */
	.mobile-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.65);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.4s ease, visibility 0.4s ease;
		z-index: 1004;
	}
	.mobile-backdrop.active {
		opacity: 1;
		visibility: visible;
	}
	.mobile-menu {
		display: none;
		position: fixed;
		top: 0;
		bottom: 0;
		right: 0;
		width: min(86vw, 380px);
		background: rgba(12, 12, 12, 0.98);
		backdrop-filter: blur(28px);
		-webkit-backdrop-filter: blur(28px);
		border-left: 1px solid rgba(255, 255, 255, 0.1);
		flex-direction: column;
		padding: 1.5rem 1.25rem calc(1.75rem + env(safe-area-inset-bottom));
		transform: translateX(105%);
		transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 1005;
		overflow-y: auto;
		overscroll-behavior: contain;
		box-shadow: -15px 0 50px rgba(0, 0, 0, 0.8);
	}
	.mobile-menu.active {
		transform: translateX(0);
	}
	.mm-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1.25rem;
		margin-bottom: 0.75rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.mm-brand {
		display: flex;
		align-items: center;
	}
	.mm-logo {
		height: 48px;
		width: auto;
		filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
	}
	.mm-close-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--text-primary);
		cursor: pointer;
		transition: all 0.25s ease;
	}
	.mm-close-btn:hover {
		background: rgba(245, 158, 11, 0.15);
		border-color: var(--accent);
		color: var(--accent);
		transform: scale(1.05);
	}
	.mm-links {
		display: flex !important;
		flex-direction: column !important;
		gap: 0.35rem;
		width: 100%;
		padding: 0;
		margin: 0;
	}
	.mm-links a,
	.mobile-menu .mobile-cta {
		display: flex !important;
		flex-direction: row !important;
		align-items: center;
		gap: 0.9rem;
		padding: 0.85rem 1rem;
		color: var(--text-secondary);
		text-decoration: none;
		border-radius: 12px;
		font-size: 1.25rem;
		font-family: "Motivate", "Inter", sans-serif;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid transparent;
		box-sizing: border-box;
		white-space: nowrap;
		transition: all 0.25s ease;
	}
	.mm-links a .mm-index {
		font-size: 0.8rem;
		font-family: "Inter", monospace, sans-serif;
		font-weight: 700;
		letter-spacing: 1px;
		color: var(--accent);
		opacity: 0.75;
		min-width: 24px;
	}
	.mm-links a .mm-text {
		flex: 1;
		font-weight: 500;
	}
	.mm-links a:hover {
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.08);
	}
	.mm-links a.active {
		color: var(--accent);
		background: rgba(245, 158, 11, 0.1);
		border-color: rgba(245, 158, 11, 0.25);
	}
	/* Staggered entrance */
	@keyframes mmIn {
		from {
			opacity: 0;
			transform: translateX(18px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
	.mobile-menu.active .mm-links a,
	.mobile-menu.active .mobile-cta {
		animation: mmIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	.mobile-menu.active .mm-links a:nth-child(1) { animation-delay: 0.06s; }
	.mobile-menu.active .mm-links a:nth-child(2) { animation-delay: 0.11s; }
	.mobile-menu.active .mm-links a:nth-child(3) { animation-delay: 0.16s; }
	.mobile-menu.active .mm-links a:nth-child(4) { animation-delay: 0.21s; }
	.mobile-menu.active .mm-links a:nth-child(5) { animation-delay: 0.26s; }
	.mobile-menu.active .mm-links a:nth-child(6) { animation-delay: 0.31s; }
	.mobile-menu.active .mm-links a:nth-child(7) { animation-delay: 0.36s; }
	.mobile-menu.active .mobile-cta { animation-delay: 0.42s; }

	/* CTA */
	.mobile-menu .mobile-cta {
		margin-top: 1.25rem;
		background: var(--accent-gradient);
		color: #000;
		font-weight: 600;
		font-size: 1.15rem;
		justify-content: center;
		padding: 1rem;
		text-align: center;
	}

	/* Social shortcuts pinned to the bottom */
	.mm-social {
		margin-top: auto;
		padding-top: 1.5rem;
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		border-top: 1px solid var(--border-color);
	}
	.mm-social a {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		color: var(--text-secondary);
		transition: all 0.3s ease;
	}
	.mm-social a:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: #000;
		transform: translateY(-3px);
	}

	/* Lock page scroll while the mobile menu is open */
	:global(body.menu-open) {
		overflow: hidden;
	}
	/* Keep floating widgets (chat button / cookie banner) out of the drawer's way */
	:global(body.menu-open) :global(.chat-widget),
	:global(body.menu-open) :global(.cookie-banner) {
		opacity: 0 !important;
		visibility: hidden !important;
		pointer-events: none !important;
		transition: opacity 0.25s ease, visibility 0.25s ease;
	}

	@media (max-width: 900px) {
		.internal-links {
			display: none;
		}
		/* Keep the language switcher visible on mobile */
		.nav-cta {
			display: flex;
			gap: 0.5rem;
			margin-inline-start: auto;
		}
		.nav-cta .contact-btn {
			display: none;
		}
		.mobile-menu-btn {
			display: flex;
		}
		.mobile-menu {
			display: flex;
		}
		header {
			padding: 0.75rem 1rem;
		}
		.logo {
			height: 64px;
		}
		header.scrolled {
			padding: 0.5rem 1rem;
		}
		header.scrolled .logo {
			height: 54px;
		}
	}

	/* LTR (English) Styles for Header */
	:global([dir="ltr"]) header {
		direction: ltr;
	}

	:global([dir="ltr"]) nav {
		flex-direction: row;
	}

	:global([dir="ltr"]) .internal-links {
		flex-direction: row;
	}

	:global([dir="ltr"]) .nav-cta {
		flex-direction: row;
	}

	/* RTL Styles for Header */
	:global([dir="rtl"]) header {
		direction: rtl;
	}

	:global([dir="rtl"]) nav {
		flex-direction: row;
		direction: rtl;
	}

	:global([dir="rtl"]) .internal-links {
		flex-direction: row;
		gap: 0.75rem;
	}

	:global([dir="rtl"]) .internal-links :global(a) {
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
		font-size: 1.9rem;
		font-weight: 300;
		padding: 0.75rem 1.25rem;
	}

	:global([dir="rtl"]) .nav-cta {
		flex-direction: row;
		gap: 0.75rem;
	}

	:global([dir="rtl"]) .contact-btn {
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
		font-size: 1.7rem;
		font-weight: 300;
		padding: 0.85rem 1.5rem;
	}

	/* RTL drawer: cleanly styled on right side with proper Arabic typography */
	:global([dir="rtl"]) .mobile-menu {
		right: 0;
		left: auto;
		border-left: 1px solid rgba(255, 255, 255, 0.1);
		border-right: none;
		text-align: right;
		direction: rtl;
		transform: translateX(105%);
	}
	:global([dir="rtl"]) .mobile-menu.active {
		transform: translateX(0);
	}
	:global([dir="rtl"]) .mm-header {
		flex-direction: row;
		direction: rtl;
	}
	:global([dir="rtl"]) .mm-links {
		display: flex !important;
		flex-direction: column !important;
		text-align: right;
		direction: rtl;
	}
	:global([dir="rtl"]) .mm-links a {
		flex-direction: row !important;
		text-align: right;
		direction: rtl;
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
		font-size: 1.35rem;
		font-weight: 300;
	}
	:global([dir="rtl"]) .mobile-menu .mobile-cta {
		font-family: "GumelaArabic", "Cairo", "Tajawal", sans-serif;
		font-size: 1.35rem;
		font-weight: 300;
	}
	:global([dir="rtl"]) .mm-links a .mm-index {
		font-family: "Inter", monospace, sans-serif;
	}
	@keyframes mmInRtl {
		from {
			opacity: 0;
			transform: translateX(18px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
	:global([dir="rtl"]) .mobile-menu.active .mm-links a,
	:global([dir="rtl"]) .mobile-menu.active .mobile-cta {
		animation-name: mmInRtl;
	}
	:global([dir="rtl"]) .mm-social {
		direction: ltr;
	}
</style>

<script>
	const menuBtn = document.getElementById("mobileMenuBtn");
	const mobileMenu = document.getElementById("mobileMenu");
	const backdrop = document.getElementById("mobileBackdrop");
	const closeBtn = document.getElementById("mobileMenuCloseBtn");

	const openMenu = () => {
		menuBtn?.classList.add("active");
		mobileMenu?.classList.add("active");
		backdrop?.classList.add("active");
		menuBtn?.setAttribute("aria-expanded", "true");
		document.body.classList.add("menu-open");
	};

	const closeMenu = () => {
		menuBtn?.classList.remove("active");
		mobileMenu?.classList.remove("active");
		backdrop?.classList.remove("active");
		menuBtn?.setAttribute("aria-expanded", "false");
		document.body.classList.remove("menu-open");
	};

	// Tap the dark backdrop or dedicated close button to close
	backdrop?.addEventListener("click", closeMenu);
	closeBtn?.addEventListener("click", closeMenu);

	menuBtn?.addEventListener("click", () => {
		if (mobileMenu?.classList.contains("active")) {
			closeMenu();
		} else {
			openMenu();
		}
	});

	// Close the menu after choosing a link (mobile UX)
	mobileMenu?.querySelectorAll(".mm-links a, .mobile-cta").forEach((link) => {
		link.addEventListener("click", closeMenu);
	});

	// Close on Escape key
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMenu();
	});

	// Close automatically when resizing up to desktop
	window.addEventListener("resize", () => {
		if (window.innerWidth > 900) closeMenu();
	});

	// Compact header after scrolling
	const headerEl = document.querySelector("header");
	const syncHeaderHeight = () => {
		if (headerEl && window.scrollY <= 10) {
			document.documentElement.style.setProperty(
				"--header-height",
				`${headerEl.offsetHeight}px`
			);
		}
	};
	const updateHeader = () => {
		headerEl?.classList.toggle("scrolled", window.scrollY > 80);
	};
	window.addEventListener("scroll", updateHeader, { passive: true });
	window.addEventListener("resize", () => {
		syncHeaderHeight();
	}, { passive: true });
	syncHeaderHeight();
	updateHeader();
</script>
