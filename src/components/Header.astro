---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

// Current-page detection for the mobile drawer links
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^/]+/g);
const navClass = (href: string) =>
	href === pathname || href === "/" + (subpath?.[0] || "")
		? "active"
		: "";
---

<!-- Google Tag Manager (noscript) -->
<noscript
	><iframe
		src="https://www.googletagmanager.com/ns.html?id=GTM-5447QWGH"
		height="0"
		width="0"
		style="display:none;visibility:hidden"></iframe></noscript
>
<!-- End Google Tag Manager (noscript) -->

<header>
	<nav>
		<a href="/" class="logo-link">
			<img src="/images/logo.png" alt="Omar Creatives" class="logo" />
		</a>
		<div class="internal-links">
			<HeaderLink href="/"
				><span data-i18n="nav.home">Home</span></HeaderLink
			>
			<HeaderLink href="/services"
				><span data-i18n="nav.services">Services</span></HeaderLink
			>
			<HeaderLink href="/projects"
				><span data-i18n="nav.work">Work</span></HeaderLink
			>

			<HeaderLink href="/testimonials"
				><span data-i18n="nav.testimonials">Testimonials</span
				></HeaderLink
			>
			<HeaderLink href="/blog"
				><span data-i18n="nav.blog">Blog</span></HeaderLink
			>
		</div>
		<div class="nav-cta">
			<LanguageSwitcher />
			<a href="/contact" class="contact-btn"
				><span data-i18n="nav.letsTalk">Contact Me</span></a
			>
		</div>
		<button
			class="mobile-menu-btn"
			id="mobileMenuBtn"
			aria-label="Toggle Menu"
			aria-expanded="false"
			aria-controls="mobileMenu"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
	</nav>
</header>

<!-- ── Mobile drawer + backdrop ── -->
<div class="mobile-backdrop" id="mobileBackdrop"></div>
<div class="mobile-menu" id="mobileMenu">
	<div class="mm-header">
		<a href="/" class="mm-brand">
			<img src="/images/logo.png" alt="Omar Creatives" class="mm-logo" />
		</a>
		<button class="mm-close-btn" id="mobileMenuCloseBtn" aria-label="Close menu">
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>
	<nav class="mm-links">
		<a href="/" class:list={navClass("/")}>
			<span class="mm-index">01</span>
			<span class="mm-text" data-i18n="nav.home">Home</span>
		</a>
		<a href="/services" class:list={navClass("/services")}>
			<span class="mm-index">02</span>
			<span class="mm-text" data-i18n="nav.services">Services</span>
		</a>
		<a href="/projects" class:list={navClass("/projects")}>
			<span class="mm-index">03</span>
			<span class="mm-text" data-i18n="nav.work">Work</span>
		</a>
		<a href="/testimonials" class:list={navClass("/testimonials")}>
			<span class="mm-index">04</span>
			<span class="mm-text" data-i18n="nav.testimonials">Testimonials</span>
		</a>
		<a href="/blog" class:list={navClass("/blog")}>
			<span class="mm-index">05</span>
			<span class="mm-text" data-i18n="nav.blog">Blog</span>
		</a>
		<a href="/about" class:list={navClass("/about")}>
			<span class="mm-index">06</span>
			<span class="mm-text" data-i18n="nav.about">About</span>
		</a>
		<a href="/faq" class:list={navClass("/faq")}>
			<span class="mm-index">07</span>
			<span class="mm-text" data-i18n="nav.faq">FAQ</span>
		</a>
	</nav>
	<a href="/contact" class="mobile-cta">
		<span data-i18n="nav.letsTalk">Contact Me</span>
	</a>
	<div class="mm-social">
		<a
			href="https://wa.me/201211867464"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="WhatsApp"
		>
			<svg viewBox="0 0 24 24" width="18" height="18">
				<path
					fill="currentColor"
					d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
				></path>
			</svg>
		</a>
		<a
			href="https://www.linkedin.com/in/omar-abdelfattah/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="LinkedIn"
		>
			<svg viewBox="0 0 24 24" width="18" height="18">
				<path
					fill="currentColor"
					d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
				></path>
			</svg>
		</a>
		<a
			href="https://twitter.com/omar_abdelfattah"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Twitter"
		>
			<svg viewBox="0 0 24 24" width="18" height="18">
				<path
					fill="currentColor"
					d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
