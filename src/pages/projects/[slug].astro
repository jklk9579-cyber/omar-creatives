					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					><circle cx="18" cy="5" r="3"></circle><circle
						cx="6"
						cy="12"
						r="3"></circle><circle cx="18" cy="19" r="3"
					></circle><path
						d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"
					></path></svg
				>
				<span data-i18n="project.share">Share</span>
			</button>
		</div>

		<!-- ── Key Impact Metrics ── -->
		{
			metrics && metrics.length > 0 && (
				<section class="metrics-section reveal">
					<div class="metrics-grid">
						{metrics.map((m) => (
							<div class="metric-card">
								<div class="metric-value">{m.value}</div>
								<div class="metric-label lang-en">{m.label}</div>
								<div class="metric-label lang-ar">{m.label_ar || m.label}</div>
							</div>
						))}
					</div>
				</section>
			)
		}

		<!-- ── Problem vs Solution Bento Grid ── -->
		{
			(challenge || solution) && (
				<section class="ps-section reveal">
					<div class="ps-grid">
						{challenge && (
							<div class="ps-card challenge-card">
								<div class="ps-tag challenge-tag">
									<span class="lang-en">The Challenge / Problem</span>
									<span class="lang-ar">التحدي والمشكلة</span>
								</div>
								<div class="ps-title lang-en">The Strategic Hurdle</div>
								<div class="ps-title lang-ar">التحدي الأساسي للعميل</div>
								<div class="ps-desc lang-en">{challenge}</div>
								<div class="ps-desc lang-ar">{challenge_ar || challenge}</div>
							</div>
						)}
						{solution && (
							<div class="ps-card solution-card">
								<div class="ps-tag solution-tag">
									<span class="lang-en">The Engineering & Creative Solution</span>
									<span class="lang-ar">الحل الإبداعي والتقني</span>
								</div>
								<div class="ps-title lang-en">Our Execution Approach</div>
								<div class="ps-title lang-ar">استراتيجية الحل والتنفيذ</div>
								<div class="ps-desc lang-en">{solution}</div>
								<div class="ps-desc lang-ar">{solution_ar || solution}</div>
							</div>
						)}
					</div>
				</section>
			)
		}

		<!-- ── Interactive Before & After Slider ── -->
		{
			beforeAfter && (
				<section class="before-after-section reveal">
					<div class="ba-header">
						<h2 class="lang-en">Transformation: Before & After</h2>
						<h2 class="lang-ar">التحول البصري: قبل وبعد</h2>
						<div class="line" />
					</div>
					<div class="ba-wrapper" id="beforeAfterSlider">
						<img src={beforeAfter.beforeImg} alt="Before" class="ba-img" />
						<div class="ba-badge before">{beforeAfter.beforeLabel || "Before"}</div>
						<div class="ba-after-container" id="baAfterContainer">
							<img src={beforeAfter.afterImg} alt="After" class="ba-img" />
							<div class="ba-badge after">{beforeAfter.afterLabel || "After (Redesign)"}</div>
						</div>
						<div class="ba-handle" id="baHandle">
							<div class="ba-handle-button">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="m8 7-5 5 5 5M16 7l5 5-5 5" />
								</svg>
							</div>
						</div>
					</div>
				</section>
			)
		}

		<!-- ── Project Video ── -->
		{
			video_url && (
				<div class="project-video-section">
					<div class="video-wrapper">
						{video_url.includes("drive.google.com") ? (
							<iframe
								src={video_url
									.replace("/view", "/preview")
									.replace("?usp=drive_link", "")
									.replace("?usp=sharing", "")}
								allow="autoplay"
								allowfullscreen
							/>
						) : (
							<video controls playsinline preload="metadata">
								<source src={video_url} type="video/mp4" />
							</video>
						)}
					</div>
				</div>
			)
		}

		<!-- ── Deep Case Study Markdown Content ── -->
		<section class="project-content-section reveal">
			<div class="case-study-prose">
				<Content />
			</div>
		</section>

		<!-- ── Deliverables & Skills Tags ── -->
		{
			tags && tags.length > 0 && (
				<section class="tags-section reveal">
					<div class="tags-container">
						{tags.map((t) => (
							<span class="tag-pill">
								<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								{t}
							</span>
						))}
					</div>
				</section>
			)
		}

		<!-- ── Client Testimonial Endorsement ── -->
		{
			testimonial && (
				<section class="testimonial-section reveal">
					<div class="testimonial-card">
						<div class="testimonial-stars">
							{[...Array(5)].map(() => (
								<svg viewBox="0 0 24 24">
									<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
								</svg>
							))}
						</div>
						<div class="testimonial-quote lang-en">"{testimonial.quote}"</div>
						<div class="testimonial-quote lang-ar">"{testimonial.quote_ar || testimonial.quote}"</div>
						<div class="testimonial-author-meta">
							{testimonial.avatar && (
								<img src={testimonial.avatar} alt={testimonial.author} class="testimonial-avatar" />
							)}
							<div>
								<div class="testimonial-name">{testimonial.author}</div>
								<div class="testimonial-title">{testimonial.role}</div>
							</div>
						</div>
					</div>
				</section>
			)
		}

		<!-- ── Gallery Section ── -->
		{
			galleryImages.length > 0 && (
				<section class="gallery-section reveal">
					<div class="gallery-header">
						<h2 data-i18n="project.gallery">Visual Assets & Gallery</h2>
						<div class="line" />
						<span class="count">
							{galleryImages.length}{" "}
							<span data-i18n="project.photos">photos</span>
						</span>
					</div>
					<div class="gallery-grid">
						{galleryImages.map((img, i) => (
							<div class="gallery-item" data-lightbox-trigger={i}>
								<img
									src={img}
									alt={`${title} - ${i + 1}`}
									loading="lazy"
								/>
								<div class="overlay">
									<div class="zoom-icon">
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
										>
											<circle cx="11" cy="11" r="8" />
											<path d="m21 21-4.3-4.3M11 8v6M8 11h6" />
										</svg>
									</div>
									<span class="img-num">
										{i + 1} / {galleryImages.length}
									</span>
								</div>
							</div>
						))}
					</div>
				</section>
			)
