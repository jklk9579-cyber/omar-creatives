					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
				>
				<span data-i18n="project.back">All Projects</span>
			</a>
		</div>

		<!-- ── Hero Image ── -->
		<section class="project-hero">
			<div class="hero-image-container" data-lightbox-trigger="0">
