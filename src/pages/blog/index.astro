---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1400px;
				margin: 0 auto;
				padding: 10rem 2rem 5rem;
			}
			.blog-header {
				text-align: center;
				margin-bottom: 4rem;
				opacity: 0;
				transform: translateY(20px);
				animation: fadeInUp 0.8s forwards;
			}
			.blog-header h1 {
				font-size: 3.5rem;
				margin-bottom: 1rem;
				background: var(--accent-gradient);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
				gap: 2.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				opacity: 0;
				transform: translateY(30px);
				animation: fadeInUp 0.8s forwards;
			}
			ul li:nth-child(1) {
				animation-delay: 0.1s;
			}
			ul li:nth-child(2) {
				animation-delay: 0.2s;
			}
			ul li:nth-child(3) {
				animation-delay: 0.3s;
			}
			ul li:nth-child(4) {
				animation-delay: 0.4s;
			}
			ul li:nth-child(5) {
				animation-delay: 0.5s;
			}
			ul li:nth-child(6) {
				animation-delay: 0.6s;
			}

			.blog-card {
				display: block;
				text-decoration: none;
				height: 100%;
				background: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 20px;
				overflow: hidden;
				transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			}
			.blog-card:hover {
				transform: translateY(-10px);
				border-color: var(--accent);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
			}
			.image-container {
				width: 100%;
				height: 240px;
				overflow: hidden;
			}
			.image-container img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.6s ease;
			}
			.blog-card:hover .image-container img {
				transform: scale(1.1);
			}
			.content {
				padding: 1.5rem;
			}
			.title {
				margin: 0 0 0.75rem 0;
				color: var(--text-primary);
				font-size: 1.5rem;
				line-height: 1.3;
				transition: color 0.3s ease;
			}
			.blog-card:hover .title {
				color: var(--accent);
			}
			.date {
				font-size: 0.9rem;
				color: var(--text-secondary);
				margin-bottom: 0.5rem;
			}
			.tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-top: 1rem;
			}
			.tag {
				font-size: 0.75rem;
				padding: 0.25rem 0.75rem;
				background: rgba(255, 255, 255, 0.05);
				border-radius: 100px;
				color: var(--text-secondary);
				border: 1px solid var(--border-color);
			}

			@keyframes fadeInUp {
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@media (max-width: 900px) {
				main {
					padding: 8rem 1.5rem 4rem;
				}
				.blog-header h1 {
					font-size: 2.5rem;
				}
				ul {
					grid-template-columns: 1fr;
				}
			}

			/* Bilingual Toggles */
			[dir="rtl"] .en-only {
				display: none;
			}
			[dir="ltr"] .ar-only {
				display: none;
			}
			[dir="rtl"] .title {
				font-family: var(--font-arabic);
				font-weight: 300;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-header">
				<h1 class="en-only">Latest Insights</h1>
				<h1 class="ar-only">أحدث الرؤى الرقمية</h1>
				<p class="en-only">
					Exploring the intersection of AI, Design, and Technology.
				</p>
				<p class="ar-only">
					استكشاف تداخل الذكاء الاصطناعي والتصميم والتكنولوجيا.
				</p>
			</div>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="blog-card">
									<div class="image-container">
										{post.data.heroImage &&
											(typeof post.data.heroImage ===
											"string" ? (
												<img
													src={post.data.heroImage}
													alt=""
													loading="lazy"
												/>
											) : (
												<Image
													width={800}
													height={450}
													src={post.data.heroImage}
													alt=""
												/>
											))}
									</div>
									<div class="content">
										<p class="date">
											<FormattedDate
												date={post.data.pubDate}
											/>
										</p>
										<h4 class="title en-only">
											{post.data.title}
										</h4>
										<h4 class="title ar-only">
											{post.data.title_ar ||
												post.data.title}
										</h4>
										<div class="tags">
											{post.data.tags?.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
